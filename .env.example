# Configuración web de Firebase (app "Arete Web Publica").
# Estos valores NO son secretos: identifican el proyecto y viajan en cualquier
# web que use Firebase. La seguridad real está en las reglas de Firestore
# (solo lectura de contenido publicado) + App Check + restricción de la API key
# por dominio en Google Cloud Console.
# En producción se cargan desde las Variables del repositorio en GitHub Actions.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=arete-apos.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=arete-apos
VITE_FIREBASE_APP_ID=
# Clave de sitio reCAPTCHA v3 para App Check (pública). Vacío = desactivado.
VITE_RECAPTCHA_SITE_KEY=
